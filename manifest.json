{
  "manifest_version": 3,
  "name": "Use My Profile Account",
  "version": "1.0.1",
  "description": "Makes Microsoft 365, Azure and other Microsoft Entra sign-ins use the work account of the Edge profile you're using.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Use My Profile Account",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "identity.email",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://login.microsoft.com/*",
    "https://login.windows.net/*",
    "https://sts.windows.net/*"
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://login.microsoftonline.com/common/userrealm/; base-uri 'none'; form-action 'none'"
  },
  "storage": {
    "managed_schema": "schema.json"
  }
}
